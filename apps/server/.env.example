# Servidor BullTracer
HOST=0.0.0.0
PORT=4000

# Caminho do SQLite local (configurações do dashboard — NUNCA jobs)
DATABASE_PATH=./data/dashboard.db
DATABASE_MIGRATE=true

# Logging (pino)
LOG_LEVEL=info

# Webhooks
WEBHOOK_TIMEOUT_MS=8000
WEBHOOK_RETRY_ATTEMPTS=3

# Alertas: lembrete de alerta ativo (ms; 0 desliga), tempo sem violação para recuperar e frequência da checagem
ALERT_REMINDER_MS=900000
ALERT_RECOVERY_MS=60000
ALERT_TICK_MS=5000
